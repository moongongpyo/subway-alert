# Copy to .env.team and fill API keys. scripts/start-local.ps1 loads it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TMAP_APP_KEY=
SEOUL_NOTICE_API_KEY=
JDBC_DATABASE_URL=jdbc:h2:file:./data/subway;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
APP_MODE=DEMO
TMAP_DAILY_BUDGET=10
PORT=8080
