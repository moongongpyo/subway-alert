OPENAI_API_KEY=
# Nosana remains primary; automatic OpenAI recovery uses the same spending caps.
MODEL_PROVIDER=openai
# Requires OPENAI_API_KEY. Set false to disable automatic recovery.
NOSANA_OPENAI_FALLBACK=true
# Direct Nosana Ollama deployment.
NOSANA_BASE_URL=
NOSANA_INFERENCE_TOKEN=
# UTC ISO expiry copied from the finite deployment. No automatic renewals.
NOSANA_EXPIRES_AT=
NOSANA_HOURLY_USD=0.40
NOSANA_MAX_USD=2.40
# Optional SDXL/ComfyUI deployment for synthetic experiment images.
NOSANA_IMAGE_BASE_URL=
NOSANA_IMAGE_TOKEN=
NOSANA_IMAGE_EXPIRES_AT=
DAYTONA_API_KEY=
# Optional: a prebuilt snapshot with Node 22+, Python 3, Chromium, Playwright,
# PostgreSQL and git. See sandbox/Dockerfile. Empty uses Daytona's default image.
DAYTONA_SNAPSHOT=
PORT=3000
HOST=127.0.0.1
# Railway private single-operator deployment: HOST=0.0.0.0, HTTPS origin,
# a random password (24+ characters), one replica and /app/data volume.
PUBLIC_ORIGIN=
ACCESS_USERNAME=admin
ACCESS_PASSWORD=
# Maximum aggregate sandbox wall minutes admitted per UTC day; reservations are
# deliberately not refunded, even if jobs finish early. Separate from model spend.
# Hackathon development/demo: up to 83 preparations/day at 120 minutes each.
DAYTONA_DAILY_MINUTES=10000
DAYTONA_MAX_SANDBOXES=10
# Optional pricing hints. Unknown hosts prompt the user in the API connection UI.
# Known free API hosts, comma-separated. No inference by models.
FREE_API_HOSTS=
PAID_API_RATES={}
EXTERNAL_JOB_BUDGET_USD=0
EXTERNAL_USER_REQUESTS=50
