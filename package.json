{
  "name": "url-to-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:docs-browser": "node --test test/docs-browser.integration.js",
    "check": "node scripts/check.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js"
  },
  "dependencies": {
    "@daytona/sdk": "0.214.0",
    "cheerio": "1.2.0",
    "express": "5.2.1",
    "openai": "7.18.0",
    "playwright": "1.58.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
